# Copy to .env.local for local work. On Vercel, add the same names under Settings > Environment Variables.
# Never commit real values and never paste them into a chat.

# --- Database (required) ---------------------------------------------------
# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
# Local:    postgres://postgres@127.0.0.1:54329/souq_dev
DATABASE_URL=
# Optional: the Supabase CA certificate (PEM text) to verify the database server certificate.
DATABASE_CA_CERT=

# --- Supabase (required in production) ---------------------------------------
# Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this one to the browser. Used for file uploads.
SUPABASE_SERVICE_ROLE_KEY=

# --- Secrets (required) --------------------------------------------------------
# Random strings of at least 32 characters, for example from: openssl rand -hex 32
# ID_HMAC_KEY protects ID document numbers. Never change it after launch, or the
# "one ID, one account" check stops matching older accounts.
ID_HMAC_KEY=
# Protects the scheduled job address /api/cron/tick.
CRON_SECRET=

# --- Optional --------------------------------------------------------------------
# WhatsApp number of the support team, digits only with country code, for example 201012345678.
WHATSAPP_SUPPORT_NUMBER=

# --- Local development only ---------------------------------------------------
# With no Supabase keys the site uses a stand-in sign-in and stores files on disk.
# AUTH_PROVIDER=dev
# STORAGE_PROVIDER=local
# AUTH_SECRET=        (signs the stand-in sign-in cookie, at least 32 characters)
